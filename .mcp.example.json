{
    "mcpServers": {
      "n8n-mcp": {
        "command": "node",
        "args": [
          "/home/{user-name}/node_modules_global/n8n-mcp/dist/mcp/index.js"
        ],
        "env": {
          "MCP_MODE": "stdio",
          "LOG_LEVEL": "error",
          "DISABLE_CONSOLE_OUTPUT": "true",
          "N8N_API_URL": "https://n8n.vendoteca.com",
          "N8N_BASE_URL": "https://n8n.vendoteca.com",
          "N8N_API_KEY": "{n8n-api-key}"
        }
      }
    }
}