# KAIROS-MANAGED-START: framework
# ── Framework / Instância ─────────────────────────────────────
# KAIROS_INSTANCE_NAME — identificação desta instância.
# Usado pelo framework para incluir um segmento no nome dos outputs gerados
# pelos agentes, evitando colisão quando múltiplos membros de uma equipe rodam
# o mesmo agente no mesmo dia. Ver `.claude/rules/output-naming.md`.
# Se ausente: o framework usa "default" e emite warning na sessão.
# O nome deve ser escrito em kebab-case.
# Exemplos: joao | maria | luis-antonio-da-silva | vitoria-goncalves | studio-acme | salao-da-marcia.
KAIROS_INSTANCE_NAME=
# KAIROS-MANAGED-END: framework
# KAIROS-MANAGED-START: ai-providers
# ── AI Providers ─────────────────────────────────────────────
# Anthropic (optional — needed only if your agent scripts make direct API calls via @anthropic-ai/sdk)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (optional — for squads using GPT models)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek (optional — cost-efficient for high-volume tasks)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter (optional — multi-model routing)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# KAIROS-MANAGED-END: ai-providers
# KAIROS-MANAGED-START: automation
# ── Automation / Workflow ─────────────────────────────────────
# n8n (para squads que integram com n8n)
N8N_API_URL=            # ex: https://n8n.exemplo.com
N8N_API_KEY=            # chave de API do n8n (Settings > API)
# KAIROS-MANAGED-END: automation
# KAIROS-MANAGED-START: database
# ── Database / Backend ───────────────────────────────────────
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # admin operations only
# KAIROS-MANAGED-END: database
# KAIROS-MANAGED-START: communication
# ── Communication ─────────────────────────────────────────────
# SMTP — envio de e-mail (para agentes que enviam diretamente, não via n8n)
SMTP_HOST=               # ex: smtp.gmail.com | smtp.office365.com
SMTP_PORT=               # 587 (STARTTLS, recomendado) | 465 (SSL) | 25 (sem criptografia)
SMTP_SECURE=             # true para porta 465 (SSL), false para 587 (STARTTLS)
SMTP_USER=               # e-mail de autenticação
SMTP_PASS=               # senha ou app password (Gmail/Outlook requerem app password com 2FA)
SMTP_FROM=               # endereço do remetente — ex: nome@exemplo.com

# IMAP — recebimento e leitura de e-mail (para agentes que monitoram caixa de entrada)
IMAP_HOST=               # ex: imap.gmail.com | outlook.office365.com
IMAP_PORT=               # 993 (SSL, recomendado) | 143 (STARTTLS)
IMAP_SECURE=             # true para porta 993 (SSL)
IMAP_USER=               # mesmo e-mail do SMTP na maioria dos casos
IMAP_PASS=               # mesma senha/app password do SMTP
# KAIROS-MANAGED-END: communication
# KAIROS-MANAGED-START: search
# ── Search / Research ─────────────────────────────────────────
# Exa (web search for agents)
# https://exa.ai/
EXA_API_KEY=
# KAIROS-MANAGED-END: search
# KAIROS-MANAGED-START: version-control
# ── Version Control ───────────────────────────────────────────
# GitHub (para squads que interagem com GitHub)
GITHUB_TOKEN=
# KAIROS-MANAGED-END: version-control
# KAIROS-MANAGED-START: project-management
# ── Project Management ────────────────────────────────────────
# Trello (para squads que gerenciam pipeline no Trello)
# API key e token: https://trello.com/app-key
# Board ID: abrir o board, adicionar .json à URL e copiar o campo "id"
# IDs das listas: GET https://api.trello.com/1/boards/{TRELLO_BOARD_ID}/lists?key=...&token=...
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# KAIROS-MANAGED-END: project-management
