# ============================================================
# Kairos — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All variables are optional except ANTHROPIC_API_KEY.
# DO NOT commit .env — it contains secrets.
# ============================================================

# ── AI Providers ─────────────────────────────────────────────
# Anthropic (required — default model engine)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (optional — for squads using GPT models)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek (optional — cost-efficient for high-volume tasks)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter (optional — multi-model routing)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Automation / Workflow ─────────────────────────────────────
# n8n (for squads that integrate with n8n)
N8N_API_URL=            # e.g. https://n8n.example.com
N8N_API_KEY=            # n8n API key (Settings > API)

# ── Database / Backend ───────────────────────────────────────
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # admin operations only

# ── Communication ─────────────────────────────────────────────
# SMTP (for squads that send email directly — not via automation tool)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Search / Research ─────────────────────────────────────────
# Exa (web search for agents)
# https://exa.ai/
EXA_API_KEY=

# ── Version Control ───────────────────────────────────────────
# GitHub (for squads that interact with GitHub)
GITHUB_TOKEN=

# ── Squad-specific ────────────────────────────────────────────
# Add variables for your squads below.
# Suggested format: {SQUAD_NAME}_{VARIABLE}

# Example: cold-prospecting squad
# N8N_LEADS_URL=    # Webhook URL exposing leads data
